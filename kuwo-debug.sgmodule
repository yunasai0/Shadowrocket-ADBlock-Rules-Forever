#!name=酷我音乐抓包调试
#!desc=抓取酷我VIP相关接口的返回数据，通过通知查看
#!author=yunasai0
#!version=1.0.0
#!date=2026-05-22

[Script]
酷我VIP信息1 = type=http-response, pattern=^https?:\/\/vip1\.kuwo\.cn\/vip\/enc\/user\/vip, script-path=https://raw.githubusercontent.com/yunasai0/Shadowrocket-ADBlock-Rules-Forever/release/kuwo-debug.js, requires-body=true, max-size=-1, timeout=60
酷我VIP信息2 = type=http-response, pattern=^https?:\/\/vip1\.kuwo\.cn\/vip\/v2\/user\/vip, script-path=https://raw.githubusercontent.com/yunasai0/Shadowrocket-ADBlock-Rules-Forever/release/kuwo-debug.js, requires-body=true, max-size=-1, timeout=60
酷我音乐接口 = type=http-response, pattern=^https?:\/\/music(pay)?\.kuwo\.cn\/music\.pay\?newver=3, script-path=https://raw.githubusercontent.com/yunasai0/Shadowrocket-ADBlock-Rules-Forever/release/kuwo-debug.js, requires-body=true, max-size=-1, timeout=60
酷我个人信息 = type=http-response, pattern=^https?:\/\/vip1\.kuwo\.cn\/commercia\/vipTab\/myTab\/base, script-path=https://raw.githubusercontent.com/yunasai0/Shadowrocket-ADBlock-Rules-Forever/release/kuwo-debug.js, requires-body=true, max-size=-1, timeout=60
酷我听书信息 = type=http-response, pattern=^https?:\/\/tingshu\.kuwo\.cn\/api\/v2\/pay\/app\/getConfigInfo, script-path=https://raw.githubusercontent.com/yunasai0/Shadowrocket-ADBlock-Rules-Forever/release/kuwo-debug.js, requires-body=true, max-size=-1, timeout=60
酷我皮肤信息 = type=http-response, pattern=^https?:\/\/vip1\.kuwo\.cn\/(commercia\/)?vip\/(v2\/theme\?op\=gd|(player\/getStyleListByModel|hanger\/wear)), script-path=https://raw.githubusercontent.com/yunasai0/Shadowrocket-ADBlock-Rules-Forever/release/kuwo-debug.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% *.kuwo.cn
